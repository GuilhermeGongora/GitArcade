rules_version = '2';
// Git Arcade: regras do Firestore. Cole no console: Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'guilhermegongora2007@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function signedIn() { return request.auth != null; }
    function okName(s) {
      return s is string && s.matches("^[0-9A-Za-zÀ-ÿ][0-9A-Za-zÀ-ÿ ._'-]{1,23}$");
    }
    function okCount(v, max) { return v is int && v >= 0 && v <= max; }
    // LinkedIn: só o identificador do perfil (linkedin.com/in/<id>); o link é sempre montado pelo jogo
    function okLi(s) { return s is string && s.matches('^[A-Za-z0-9-]{3,100}$'); }
    // GitHub: só o nome de usuário (github.com/<usuario>); o link também é montado pelo jogo
    function okGh(s) { return s is string && s.matches('^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$'); }

    // Resultado de ranking (vale para o ranking final e para o do Mundo 1)
    function validEntry(d) {
      return d.keys().hasOnly(['name','ms','score','pen','li','gh','at','uid','run','manual'])
        && d.keys().hasAll(['name','ms','at'])
        && okName(d.name)
        && d.ms is int && d.ms >= 30000 && d.ms < 36000000
        && d.at is string && d.at.size() <= 40
        && (!('score' in d) || d.score == null || okCount(d.score, 16000))
        && (!('pen' in d) || okCount(d.pen, 1920000))
        && (!('li' in d) || okLi(d.li))
        && (!('gh' in d) || okGh(d.gh));
    }

    // Telemetria de cada partida (só o dono escreve, só o admin lê a lista)
    match /players/{runId} {
      allow get: if isAdmin()
        || (signedIn() && (resource == null || resource.data.uid == request.auth.uid));
      allow list, delete: if isAdmin();
      allow create: if signedIn() && validPlayer(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t0 == request.time
        && request.resource.data.lastSeen == request.time;
      allow update: if signedIn() && validPlayer(request.resource.data)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.t0 == resource.data.t0
        && request.resource.data.lastSeen == request.time
        && request.resource.data.cleared >= resource.data.cleared
        && request.resource.data.pen >= resource.data.get('pen', 0)
        && request.resource.data.skipped >= resource.data.get('skipped', 0)
        && (resource.data.get('over', null) == null || request.resource.data.over == resource.data.over)
        // o tempo do Mundo 1 é gravado uma vez e não muda mais
        && (resource.data.get('w1Ms', null) == null || request.resource.data.get('w1Ms', null) == resource.data.w1Ms)
        && (request.time > resource.data.lastSeen + duration.value(3, 's')
            || (request.resource.data.left == true && resource.data.left != true));

      function validPlayer(d) {
        return d.keys().hasOnly(['name','startedAt','lastSeen','level','cleared','finishedMs','score',
              'hintsUsed','skipped','pen','over','eggs','cmdTotal','errTotal','cmds','errs','device','test','room','left','li','gh','uid','t0','w1Ms','w1Pen'])
          && d.keys().hasAll(['name','startedAt','lastSeen','level','cleared','finishedMs','score',
              'hintsUsed','skipped','pen','over','eggs','cmdTotal','errTotal','cmds','errs','device','test','room','left','li','uid','t0'])
          && okName(d.name)
          && d.startedAt is int
          && d.level is string && d.level.size() <= 8
          && okCount(d.cleared, 16)
          && (d.finishedMs == null || okCount(d.finishedMs, 360000000))
          && okCount(d.score, 16000)
          && okCount(d.hintsUsed, 32)
          && okCount(d.skipped, 2)
          && okCount(d.pen, 1920000) && d.pen % 60000 == 0
          && (d.over == null || d.over in ['surrender', 'timeout'])
          && okCount(d.eggs, 40)
          && d.li is string && (d.li == '' || okLi(d.li))
          && (!('gh' in d) || okGh(d.gh))
          && (!('w1Ms' in d) || okCount(d.w1Ms, 360000000))
          && (!('w1Pen' in d) || (okCount(d.w1Pen, 1920000) && d.w1Pen % 60000 == 0))
          && okCount(d.cmdTotal, 100000) && okCount(d.errTotal, 100000)
          && d.cmds is map && d.cmds.size() <= 30
          && d.errs is map && d.errs.size() <= 30
          && d.device in ['mobile', 'desktop']
          && d.test is bool && d.room is bool && d.left is bool;
      }
    }

    // Ranking: 1 resultado por partida (id = uid_partida), conferido contra a partida
    match /ranking/{entryId} {
      allow get: if true;
      allow list: if request.query.limit <= 10 || isAdmin();
      allow delete: if isAdmin();
      allow create: if (isAdmin() && validEntry(request.resource.data) && request.resource.data.manual == true)
        || (signedIn() && validRun(request.resource.data)
            && entryId == request.auth.uid + '_' + request.resource.data.run);
      allow update: if false;

      function validRun(d) {
        return validEntry(d)
          && !('manual' in d)
          && d.uid == request.auth.uid
          && d.run is string && d.run.matches('^[A-Za-z0-9_-]{4,40}$')
          && runMatches(d, get(/databases/$(database)/documents/players/$(d.run)).data);
      }
      function runMatches(d, p) {
        return p.uid == request.auth.uid
          && p.cleared == 16
          && p.over == null
          && p.finishedMs == d.ms
          && p.name == d.name
          && p.pen == d.get('pen', 0)
          && p.li == d.get('li', '')
          && p.get('gh', '') == d.get('gh', '')
          // o tempo do ranking inclui a penalidade das dicas; o tempo real no servidor precisa cobrir o resto
          && request.time.toMillis() - p.t0.toMillis() >= d.ms - d.get('pen', 0) - 20000;
      }
    }

    // Ranking do Mundo 1: quem derrotou o primeiro boss (o relógio para nesse momento)
    match /ranking1/{entryId} {
      allow get: if true;
      allow list: if request.query.limit <= 10 || isAdmin();
      allow delete: if isAdmin();
      allow create: if (isAdmin() && validEntry(request.resource.data) && request.resource.data.manual == true)
        || (signedIn() && validRun1(request.resource.data)
            && entryId == request.auth.uid + '_' + request.resource.data.run);
      allow update: if false;

      function validRun1(d) {
        return validEntry(d)
          && !('manual' in d)
          && d.uid == request.auth.uid
          && d.run is string && d.run.matches('^[A-Za-z0-9_-]{4,40}$')
          && runMatches1(d, get(/databases/$(database)/documents/players/$(d.run)).data);
      }
      function runMatches1(d, p) {
        return p.uid == request.auth.uid
          && p.cleared >= 9
          && p.get('w1Ms', null) == d.ms
          && p.name == d.name
          && p.get('w1Pen', 0) == d.get('pen', 0)
          && p.li == d.get('li', '')
          && p.get('gh', '') == d.get('gh', '')
          && request.time.toMillis() - p.t0.toMillis() >= d.ms - d.get('pen', 0) - 20000;
      }
    }

    // Avaliações: 1 por partida (id = uid_partida). Nota do minicurso só com o código da sala,
    // conferido aqui no servidor pelo hash (o código não aparece no arquivo).
    match /reviews/{reviewId} {
      allow get, list, delete: if isAdmin();
      allow create: if signedIn() && validReview(request.resource.data)
        && reviewId == request.auth.uid + '_' + request.resource.data.run;
      allow update: if signedIn() && validReview(request.resource.data)
        && reviewId == request.auth.uid + '_' + request.resource.data.run
        && resource.data.uid == request.auth.uid
        && request.time > resource.data.at + duration.value(10, 's');

      function validReview(d) {
        return d.keys().hasOnly(['name','game','course','comment','room','roomKey','run','uid','at'])
          && d.keys().hasAll(['name','game','comment','room','run','uid','at'])
          && okName(d.name)
          && d.uid == request.auth.uid
          && d.at == request.time
          && d.game is int && d.game >= 1 && d.game <= 5
          && d.comment is string && d.comment.size() <= 500
          && d.run is string && d.run.matches('^[A-Za-z0-9_-]{4,40}$')
          && get(/databases/$(database)/documents/players/$(d.run)).data.uid == request.auth.uid
          && ((d.room == false && !('course' in d) && !('roomKey' in d))
              || (d.room == true
                  && d.course is int && d.course >= 1 && d.course <= 5
                  && d.roomKey is string && d.roomKey.size() <= 40
                  && hashing.sha256(d.roomKey + '|arcade-sala').toHexString().lower()
                       == '5abc76e08b40ad535268aa07f5e8b244a8c457d8180ce0fcb856c56d55e413c3'));
      }
    }
  }
}
